# NOTE: The BrickRelic app itself needs NO environment variables to run.
# The variable below is optional and only relevant for deployment.

# Optional: Basic Authentication password for the Vercel Edge Middleware.
# Leave unset to serve the app without a password prompt.
BASIC_AUTH_PASSWORD=your_basic_auth_password_here

# Rebrickable API key used by "Verify set" to load set part lists
# (https://rebrickable.com/api/). Put the real key in .env.local, which is gitignored.
# VITE_ variables are bundled into the browser code, so anyone using the site can read it.
VITE_REBRICKABLE_API_KEY=your_rebrickable_api_key_here
